@@ -318,6 +318,41 @@
                 "Generate one short sentence of curious babble. "

                 "Keep it under 12 words."

             )

+            # Memory-seeded babble: if we have no recent user text, borrow a seed from persistent memory.

+            # This makes idle babble reflect prior knowledge instead of starting from nothing each run.

+            mimic_last_user = str(await ctx.get_kv("mimic:last_user_text", "") or "").strip()

+            if not mimic_last_user:

+                mem_store = await ctx.get_kv("memory:store", None)

+                if mem_store is not None:

+                    def _mem_ok(it: dict) -> bool:

+                        meta_i = it.get("meta") or {}

+                        if meta_i.get("control"):

+                            return False

+                        if str(meta_i.get("role", "") or "") == "system":

+                            return False

+                        kind_i = str(meta_i.get("kind", "") or "")

+                        if kind_i.startswith("reinforcement"):

+                            return False

+                        return True

+

+                    # Prefer recent episodic user items as a seed.

+                    try:

+                        epi = mem_store.last_episodic(n=8) or []

+                    except Exception:

+                        epi = []

+                    epi = [it for it in epi if isinstance(it, dict) and _mem_ok(it)]

+                    user_epi = [it for it in epi if str((it.get("meta") or {}).get("role", "") or "") == "user"]

+                    pick_pool = user_epi or epi

+                    if pick_pool:

+                        mimic_last_user = str(pick_pool[-1].get("text", "") or "").strip()

+                    else:

+                        sem = getattr(mem_store, "semantic", []) or []

+                        sem = [it for it in sem if isinstance(it, dict) and _mem_ok(it)]

+                        if sem:

+                            tail = sem[-20:]

+                            k = int(time.time()) % len(tail)

+                            mimic_last_user = str(tail[k].get("text", "") or "").strip()

+

