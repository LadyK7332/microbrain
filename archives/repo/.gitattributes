# Export rules for `git archive` (files marked export-ignore are omitted)

# IDE/OS junk
.vs/                export-ignore
.vscode/            export-ignore
.venv/              export-ignore
__pycache__/        export-ignore
*.pyc               export-ignore
.mypy_cache/        export-ignore
.pytest_cache/      export-ignore

# Local archives/blobs
*.zip               export-ignore
*.7z                export-ignore
*.rar               export-ignore
*.tar               export-ignore
*.tar.gz            export-ignore
*.tar.bz2           export-ignore
*.gz                export-ignore
*.xz                export-ignore

# Optional: CI/Git-only stuff
.github/            export-ignore
.gitignore          export-ignore
