+

+    # ----------------------------

+    # Schema normalization (v1)

+    # ----------------------------

+    _SENSE_KEYS = ("vision", "audio", "touch", "proprio")

+

+    def _ensure_memory_schema(self, item: dict) -> dict:

+        """

+        Ensure every memory row has stable slots for future modalities.

+        This is intentionally non-destructive: it does NOT rewrite existing files,

+        it only normalizes objects in-memory and on new writes.

+        """

+        if not isinstance(item, dict):

+            return item

+

+        meta = item.get("meta") or {}

+        if not isinstance(meta, dict):

+            meta = {}

+        meta.setdefault("schema_ver", 1)

+        item["meta"] = meta

+

+        # Presence flags: False means modality not yet available/recorded

+        sp = item.get("senses_present")

+        if not isinstance(sp, dict):

+            sp = {}

+        for k in self._SENSE_KEYS:

+            sp.setdefault(k, False)

+        item["senses_present"] = sp

+

+        # Sense pointers / small payload slots (empty until sensors exist)

+        senses = item.get("senses")

+        if not isinstance(senses, dict):

+            senses = {}

+        for k in self._SENSE_KEYS:

+            senses.setdefault(k, [])

+        item["senses"] = senses

+

+        # Tagging stubs (embeddings/labels/asset refs live here later)

+        tags = item.get("sense_tags")

+        if not isinstance(tags, dict):

+            tags = {}

+        for k in self._SENSE_KEYS:

+            tags.setdefault(k, {"labels": [], "emb_ref": None, "assets": []})

+        item["sense_tags"] = tags

+

+        return item

