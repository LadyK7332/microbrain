import asyncio

from microbrain.orchestrator.orchestrator import Orchestrator
from microbrain.orchestrator.neuron_loader import auto_register_neurons
from microbrain.llm_backend import llm_generate


# Simple dummy LLM backend for testing.
# Real hookup would call llama.cpp / your actual model.
async def dummy_llm_generate(prompt: str, meta: dict) -> str:
    # Keep it obvious that this is a stub.
    return f"(dummy llm) I received:\n{prompt}"


async def main():
    ensure_llama_server(cfg)
    
    orch = Orchestrator()

    # Auto-load all neuron modules under microbrain.neurons.*
    auto_register_neurons(orch)

    # DEBUG: see which neurons actually registered
    print("Registered neurons:", list(orch.neurons.keys()))

    # Register our dummy LLM backend so LLMReasonerNeuron has something to call.
    orch.kv_store["llm:generate"] = llm_generate
    await orch.start()

    # Push raw text into the system as an "input/text" event
    await orch.push_event(
        "input/text",
        "Hello, MicroBrain!",
        meta={"source": "cli", "channel": "test"},
    )

    # Give the system a moment to process
    await asyncio.sleep(0.2)

    # Wait for the queue to drain (optional)
    await orch.wait_for_idle(timeout=1.0)

    await orch.stop()


if __name__ == "__main__":
    asyncio.run(main())
