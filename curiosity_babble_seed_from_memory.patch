                 "Generate one short sentence of curious babble. "

                 "Keep it under 12 words."

             )

+

+            # --- Memory-seeded mimic (cross-session continuity) -----------------

+            seeded_from_memory = False

+

+            # Prefer session seed if present

+            last_user_text = (await ctx.get_kv("mimic:last_user_text", "") or "").strip()

+

+            # If this session has no mimic seed yet, borrow it from persistent memory

+            if not last_user_text:

+                mem_store = await ctx.get_kv("memory:store", None)

+                if mem_store is not None:

+                    # Prefer last USER turn from episodic memory

+                    try:

+                        epi = mem_store.last_episodic(n=50) or []

+                    except Exception:

+                        epi = []

+                    for it in reversed(epi):

+                        if not isinstance(it, dict):

+                            continue

+                        meta_i = it.get("meta") or {}

+                        if meta_i.get("control"):

+                            continue

+                        if str(meta_i.get("role", "")) == "system":

+                            continue

+                        kind_i = str(meta_i.get("kind", "") or "")

+                        if kind_i.startswith("reinforcement"):

+                            continue

+                        t_i = str(it.get("text", "") or "").strip()

+                        if t_i.startswith("USER:"):

+                            cand = t_i.split("USER:", 1)[1].strip()

+                            if cand:

+                                last_user_text = cand

+                                seeded_from_memory = True

+                                break

+

+                    # Fallback: use a recent semantic memory item as a seed

+                    if not last_user_text:

+                        try:

+                            sem = getattr(mem_store, "semantic", None) or []

+                        except Exception:

+                            sem = []

+                        for it in reversed(sem[-50:]):

+                            if not isinstance(it, dict):

+                                continue

+                            meta_i = it.get("meta") or {}

+                            if meta_i.get("control"):

+                                continue

+                            if str(meta_i.get("role", "")) == "system":

+                                continue

+                            kind_i = str(meta_i.get("kind", "") or "")

+                            if kind_i.startswith("reinforcement"):

+                                continue

+                            t_i = str(it.get("text", "") or "").strip()

+                            if t_i:

+                                last_user_text = t_i

+                                seeded_from_memory = True

+                                break

+

+            # Load mimic ngrams from KV (session), or derive a small local corpus from the seed

+            unigrams = await ctx.get_kv("mimic:unigrams", {}) or {}

+            bigrams = await ctx.get_kv("mimic:bigrams", {}) or {}

+            recent_phrases = await ctx.get_kv("mimic:recent_phrases", []) or []

+

+            if (not unigrams or not bigrams) and last_user_text:

+                toks = re.findall(r"[A-Za-z0-9\']+|[.,!?;:]", last_user_text.lower())

+                if toks:

+                    if not isinstance(unigrams, dict) or not unigrams:

+                        unigrams = {}

+                    if not isinstance(bigrams, dict) or not bigrams:

+                        bigrams = {}

+                    for t in toks:

+                        if t:

+                            unigrams[t] = int(unigrams.get(t, 0)) + 1

+                    for a, b in zip(toks, toks[1:]):

+                        k = f"{a}|{b}"

+                        bigrams[k] = int(bigrams.get(k, 0)) + 1

+

+            # If we seeded from memory, persist the seed so later babble can reuse it.

+            if seeded_from_memory and last_user_text:

+                await ctx.set_kv("mimic:last_user_text", last_user_text)

+

