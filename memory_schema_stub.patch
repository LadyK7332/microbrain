+# -----------------------------------------------------------------------------
+# Memory item schema stubs (prepatch)
+# -----------------------------------------------------------------------------
+MEMORY_SCHEMA_VER = 1
+
+_DEFAULT_SENSES_PRESENT = {
+    "vision": False,
+    "audio": False,
+    "touch": False,
+    "proprio": False,
+}
+
+_DEFAULT_SENSES = {
+    "vision": [],
+    "audio": [],
+    "touch": [],
+    "proprio": [],
+}
+
+_DEFAULT_SENSE_TAGS = {
+    "vision": {"labels": [], "emb_ref": None, "keyframes": []},
+    "audio": {"transcript": "", "emb_ref": None, "motifs": []},
+    "touch": {"labels": [], "emb_ref": None},
+    "proprio": {"labels": [], "emb_ref": None},
+}
+
+def _ensure_memory_schema(item: Dict[str, Any]) -> Dict[str, Any]:
+    """Ensure memory records have stable, forward-compatible sense/tag fields.
+
+    This does NOT add new behavior; it only guarantees keys exist (possibly empty),
+    so future sensors/consolidation can fill them in.
+    """
+    if not isinstance(item, dict):
+        return item
+
+    item.setdefault("schema_ver", MEMORY_SCHEMA_VER)
+
+    sp = item.get("senses_present")
+    if not isinstance(sp, dict):
+        sp = {}
+        item["senses_present"] = sp
+    for k, v in _DEFAULT_SENSES_PRESENT.items():
+        sp.setdefault(k, v)
+
+    senses = item.get("senses")
+    if not isinstance(senses, dict):
+        senses = {}
+        item["senses"] = senses
+    for k, v in _DEFAULT_SENSES.items():
+        if k not in senses or not isinstance(senses.get(k), list):
+            senses[k] = list(v)
+
+    tags = item.get("sense_tags")
+    if not isinstance(tags, dict):
+        tags = {}
+        item["sense_tags"] = tags
+    for k, v in _DEFAULT_SENSE_TAGS.items():
+        if k not in tags or not isinstance(tags.get(k), dict):
+            tags[k] = dict(v)
+        else:
+            for kk, vv in v.items():
+                tags[k].setdefault(kk, vv)
+
+    return item
 
 
